# 이 파일을 .env 로 복사해서 채우세요. (.env 는 git에 안 올라갑니다)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 1 = 모의투자(실제 주문 안 함), 0 = 실전
DRY_RUN=1

MARKET=KRW-BTC
MA_DAYS=50
# 봇이 쓰지 않고 남겨둘 원화 (다른 용도 돈이 있으면)
KRW_RESERVE=0
POLL_SEC=300

# 모의투자에서만 사용: 매달 이 날 이 금액을 입금했다고 침
MONTHLY_DAY=10
MONTHLY_KRW=100000

# 선택: 텔레그램 알림
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
